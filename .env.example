# Optional: free key from https://www.themoviedb.org/settings/api for better search with posters.
# Copy this file to .env and fill it in. Without it, search uses iTunes (movies) + TVmaze (series).
VITE_TMDB_KEY=

# Sign in with Google / GitHub (free Supabase project, see README "Sign-in").
# Use the anon / publishable key only, never the service_role / secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: Google Client ID (public) for Google's own sign-in button, so Google's popup
# shows this site's name. Add this site under the client's "Authorised JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
